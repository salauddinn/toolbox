# Server-only. Never prefix with NEXT_PUBLIC_.
# Required for generation stages (not needed for eligibility/assessment alone).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Optional. Least-privilege public-repository rate capacity only.
# Never accept or require a user-supplied GitHub token.
GITHUB_TOKEN=

# Optional. Signs HttpOnly session cookies that bind runs to a browser.
# Falls back to AI_API_KEY when unset. Prefer a dedicated random secret in production.
TOOLBOX_SESSION_SECRET=

# Leave unset (or 0) for live AI generation. Set to 1 only for offline/fixture demos.
# TOOLBOX_DETERMINISTIC_GENERATION=0
