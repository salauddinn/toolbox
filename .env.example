# Server-only. Never prefix with NEXT_PUBLIC_.
# Primary generation provider: ClinePass MiniMax M3 (not needed for assessment or /demo).
# Create the key in Cline Settings > API Keys. These defaults use Cline's OpenAI-compatible API.
AI_BASE_URL=https://api.cline.bot/api/v1
AI_API_KEY=
AI_MODEL=cline-pass/minimax-m3

# Optional retryable-failure fallback 1: Gemini's OpenAI-compatible API.
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-3.5-flash

# Optional retryable-failure fallback 2: OpenAI.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6-luna

# Optional server-side provider request budgets. Defaults: input 65536, output 32768;
# operational maxima are input 1000000 and output 131072. Never expose as NEXT_PUBLIC_.
# These use deterministic UTF-8 byte estimates plus chat framing reserve, not exact tokenizer counts.
# The 32768 output gate is a stricter outer gate than Stage Plan operation/byte ceilings;
# a Stage Plan allowing more output may therefore be unreachable in one provider response.
# AI_INPUT_TOKEN_BUDGET=65536
# AI_OUTPUT_TOKEN_BUDGET=32768

# Optional single provider HTTP timeout in milliseconds (default 180000 = 3 minutes).
# Range: 10000–600000. Raise this if authorize fails with transport timeout on slow models.
# AI_REQUEST_TIMEOUT_MS=180000

# Optional. Least-privilege public-repository rate capacity only.
# Never accept or require a user-supplied GitHub token.
GITHUB_TOKEN=

# Optional. Signs HttpOnly session cookies that bind runs to a browser.
# Falls back to the first configured provider key when unset. Prefer a dedicated random secret in production.
TOOLBOX_SESSION_SECRET=

# Generation mode (both are supported; pick one process at a time):
# - Normal AI (default): leave TOOLBOX_DETERMINISTIC_GENERATION unset or 0.
#   Uses ClinePass MiniMax M3 by default; Gemini and OpenAI are optional transient-failure fallbacks.
# - Toolbox deterministic: set TOOLBOX_DETERMINISTIC_GENERATION=1.
#   Offline/fixture/demo path; no live model call for stage generation.
# TOOLBOX_DETERMINISTIC_GENERATION=0
